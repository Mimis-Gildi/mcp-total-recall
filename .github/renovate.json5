{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'America/New_York',
  assignees: [
    'rdd13r',
  ],
  branchPrefix: 'renovate/',
  schedule: [
    'every weekday',
  ],
  labels: [
    'dependencies',
    'renovate',
  ],
  packageRules: [
    {
      description: 'Kotlin and Coroutines together',
      matchManagers: [
        'gradle',
      ],
      groupName: 'Kotlin Updates',
      automerge: true,
      matchPackageNames: [
        '/^org\\.jetbrains\\.kotlin/',
        '/^org\\.jetbrains\\.kotlinx:kotlinx-coroutines/',
      ],
    },
    {
      description: 'MCP SDK',
      matchManagers: [
        'gradle',
      ],
      groupName: 'MCP SDK Updates',
      automerge: true,
      matchPackageNames: [
        '/^io\\.modelcontextprotocol/',
      ],
    },
    {
      description: 'Kotest framework',
      matchManagers: [
        'gradle',
      ],
      groupName: 'Kotest Updates',
      automerge: true,
      matchPackageNames: [
        '/^io\\.kotest/',
      ],
    },
    {
      description: 'Logging stack (SLF4J, Logback, kotlin-logging)',
      matchManagers: [
        'gradle',
      ],
      groupName: 'Logging Updates',
      automerge: true,
      matchPackageNames: [
        '/^org\\.slf4j/',
        '/^ch\\.qos\\.logback/',
        '/^io\\.github\\.oshai:kotlin-logging/',
      ],
    },
    {
      description: 'Gradle wrapper',
      matchManagers: [
        'gradle-wrapper',
      ],
      groupName: 'Gradle Wrapper',
      automerge: true,
    },
    {
      description: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'GitHub Actions Updates',
      automerge: true,
    },
    {
      description: 'Bundler / Jekyll (monthly, less churn)',
      matchManagers: [
        'bundler',
      ],
      groupName: 'Bundler Updates',
      automerge: true,
      schedule: [
        'monthly',
      ],
    },
  ],
  dependencyDashboard: true,
  prHourlyLimit: 5,
  prConcurrentLimit: 10,
  automerge: true,
}
